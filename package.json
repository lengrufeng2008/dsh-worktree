{
  "name": "dsh-worktree",
  "version": "0.1.0",
  "description": "Read-only worktree listing for DSH plus CLI create/remove/prune for isolated git worktrees.",
  "type": "module",
  "bin": { "dsh-worktree": "bin/dsh-worktree.mjs" },
  "exports": { ".": "./plugin/index.js", "./worktree": "./src/worktree.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
